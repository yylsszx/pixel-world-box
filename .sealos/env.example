# ============ Sealos 环境变量模板 ============
# 复制为 .sealos/env.local 并填入实际值

# PostgreSQL 连接字符串 (Sealos 自动创建数据库后获取)
# 格式: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:password@db-host:5432/pixelworld?schema=public

# Z.ai API Key (用于内置神谕模型)
# 从 https://platform.z.ai 获取
Z_API_KEY=your-z-ai-api-key-here

# NextAuth 密钥 (生产环境必须设置强随机值)
# 生成命令: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# 可选：GitHub OAuth (用于玩家登录)
# GITHUB_ID=your-github-client-id
# GITHUB_SECRET=your-github-client-secret

# 可选：Google OAuth
# GOOGLE_ID=your-google-client-id
# GOOGLE_SECRET=your-google-client-secret

# 可选：自定义域名 (Sealos 会自动配置 Ingress)
# DOMAIN=pixelworld.yourdomain.com